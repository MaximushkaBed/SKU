## Пример настройки подключения к MySQL (phpMyAdmin)
## Вставьте свои значения и сохраните как ".env"

# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4"

## Пример для локального MySQL:
# DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/sku_db?charset=utf8mb4"

